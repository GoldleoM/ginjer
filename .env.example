# Base URLs exclude /graphql. Development builds use DEV; production builds use PROD.
EXPO_PUBLIC_DEV_API_BASE_URL=https://devapi.ginjer.io
EXPO_PUBLIC_PROD_API_BASE_URL=https://prodapi.ginjer.io

# Optional base URL override for either build type.
# EXPO_PUBLIC_API_BASE_URL=https://devapi.ginjer.io
# Optional full GraphQL endpoint override (takes precedence over base URLs).
# EXPO_PUBLIC_API_URL=https://devapi.ginjer.io/graphql

EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
